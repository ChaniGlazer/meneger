PORT=4000

# Postgres connection string from your Supabase project
# Settings -> Database -> Connection string (URI), "Session pooler" or direct connection
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# Settings -> API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Storage bucket name (create it as Public in Supabase Storage)
SUPABASE_BUCKET=uploads

# Resend — used to send "forgot password" emails.
# https://resend.com/ -> API Keys
RESEND_API_KEY=your-resend-api-key
# Must be an address on a domain verified in your Resend account
RESEND_FROM_EMAIL=no-reply@yourdomain.com
RESEND_FROM_NAME=Codebloom
