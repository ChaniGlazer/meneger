# Only needed for production builds where the client and server are on
# different origins (e.g. client on Vercel, server on Render).
# Leave unset for local dev - Vite's dev-server proxy (vite.config.js) handles it.
VITE_API_URL=https://your-server.onrender.com
VITE_SOCKET_URL=https://your-server.onrender.com
